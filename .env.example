# Répertoire du fichier SQLite (créé automatiquement).
# Défaut : <racine du projet>/.data
DATA_DIR=./.data

# Drapeau Secure du cookie de session.
# - true  : toujours Secure (recommandé en production HTTPS)
# - false : jamais Secure (HTTP local uniquement)
# - vide  : déduit de X-Forwarded-Proto puis du protocole de la requête
COOKIE_SECURE=

# ---------------------------------------------------------------------------
# PostgreSQL (facultatif)
# ---------------------------------------------------------------------------
# Absent : l'application utilise SQLite. Défini : l'application utilise
# PostgreSQL (Neon, Supabase ou instance locale).
#
# Local (PostgreSQL 18 installé dans C:\Users\<vous>\pgsql) :
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/a_deux
#
# Neon/Supabase : utiliser la chaîne « pooled » pour l'application et la
# chaîne directe pour les migrations.
DATABASE_URL=
DATABASE_URL_DIRECT=

# ---------------------------------------------------------------------------
# Connexion Google (OpenID Connect, Authorization Code + PKCE)
# ---------------------------------------------------------------------------
# Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Tant que ces deux valeurs manquent, le bouton Google est masqué.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Connexion Apple (Sign in with Apple)
# ---------------------------------------------------------------------------
# Apple Developer → Certificates, Identifiers & Profiles → Services ID,
# puis Keys pour la clé .p8. `APPLE_PRIVATE_KEY` accepte les retours à la
# ligne échappés (\n). Tant que la configuration est incomplète, le bouton
# Apple est masqué.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Secret de signature des cookies OAuth (state, nonce).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SESSION_SECRET=
