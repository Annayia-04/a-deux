<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#141218" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#C5A059" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#33C5A059" />
        </shape>
    </item>
</layer-list>
